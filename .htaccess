# Force HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
    ExpiresByType application/xhtml+xml "access plus 1 day"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|swf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(css)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.(js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.(x?html?|php)$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>

# Enable Keep-Alive
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# Disable ETags
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None 

# Security headers
<IfModule mod_headers.c>
    # HSTS - Force HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Content Security Policy - Updated with SHA-256 hashes for inline scripts
    # Removes 'unsafe-inline' for better security
    # Hashes cover Google Analytics and JSON-LD structured data scripts
    # Note: If inline scripts are modified, regenerate hashes using generate-csp-hashes.js
    Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net 'sha256-4WydWrpohlqD2dd1H8lfaLvHFb8f/7QtozrtRte8EYE=' 'sha256-f+alEODsPhMrjeDuyRDUMZvoULkhYnh3GtK9V6t7Zlg=' 'sha256-myk5n12FKUYNyAet+irVqjWciV6gKsQv1D58/2JNW6M=' 'sha256-BpYi2OFPmBsP0XKzOuaok9wCTcDhfU1Mmh+y+fP4+sc=' 'sha256-4pzz6IZebozWd8RtZn18JCJqBKr9umRqQZlXFn6gbZE=' 'sha256-YFxTSiD6eZGyJJIQXoAGY+5mLuppaDMq3Qhe6o8udyw=' 'sha256-xyBEI4taDdmVZG4MqHH3kHpT53R1j6GWww5xe9RMXQE=' 'sha256-Kw93pnepfXuIkY+Ziz4KU3WMCQMX4x2O3a3sHpZXUnw=' 'sha256-2bHs4fVEXrNwJJnhPPZOPzMa338ToqLLYh/x4owGkc8=' 'sha256-Mc0iL9mWFoLk7MpLdhrmzjPjifT+1NaFduITRkbq3tc=' 'sha256-IFA5cX1tG32A40/kJCQfkA0pTlhKVV/xv7Dl0Dy5YuI=' 'sha256-88jSHl1wxIEhBaiJ96NEQSKJfSbz4NWfFtaXOFva+5U=' 'sha256-vVYst625OPfx0MGwztpG6aJBSvt3Baihwi7gU7Zqjjg=' 'sha256-brhMb7X4RupSSSwlqn3yxcPVvu8RlXf+Z7i8zeoKW/c=' 'sha256-hxtHJDaTlhfIQS4WmhFLIdKmEKYa7sOuO2yLxMmfPDM=' 'sha256-MROdkjdfxnTJi7Du8iU5lWNWTB+3esDCjTQxzCrof8I=' 'sha256-OsibCawJfsPPn3jy/MrIJARM42+HS019lYes7mKGpC0=' 'sha256-UYMYQAY6Om6LAjZE9IdaygS0XFgoQ99mZaFhQITobFo=' 'sha256-G9ct5AGyABy0Dq7TKjx+Rt35r4Yvwt8AkiOzvfcOUF8=' 'sha256-TvSXTPPuC+BwKBioAC21RKx8mFAvq4ktal9re7YXQtc=' 'sha256-jb+PRSOiZ8ok1QRSMcXfUuUn1PWKftwrLT9VDcfdKoA=' 'sha256-cRsIBrJikC+Hf+LrnVN7Y42CCbd3uarSeqUw2BrVvX4=' 'sha256-FkeF1K9QV6WojK+kEbZmWyaCtq8AQSXKyYD8Z/6hRlw=' 'sha256-6gBeELkhTrv8GX4/CtCXLdafCXW/gleASFkBSbLA6qA=' 'sha256-qkv4vzCmndcq1hDnxfEWe2ra0uRu9UFao0j1kepgZEI=' 'sha256-yU1WVXDBGrwwZOiJH+JPDLr0q2gE7k2h31lv9cedBZw=' 'sha256-9FuhnnWmCKUBvErKMRE02spG8ZOILpT/apq0LLIX9PQ=' 'sha256-eYcbuNUPoQSHdT9n+n2hPMzWh3UICpT4hNsadl/ZNL4=' 'sha256-hg8gOx+mZcRpEZ2T9NAAZyLF8Skbfbhlk2qLt4kk4/0=' 'sha256-hykIccYJVIQDADkxDEw4XvSX5Bb24jn2oU8DziT99H4=' 'sha256-ro2nlFUGWLVvNBxDW9Xech3gzjlUz1cTjoshXKYOBP4=' 'sha256-AFTT4qurxfIhMI3aocWIIDQZAhEcrAaUN+Je/yZuoBs=' 'sha256-qBDuWIRFDhrEKJYb1GWUoy23S