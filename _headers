# Security Headers for Cloudflare Pages
# This file configures HTTP security headers for all pages

/*
  # HSTS - Force HTTPS for 1 year with subdomain inclusion
  # Tells browsers to always use HTTPS for this domain
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # X-Content-Type-Options - Prevent MIME type sniffing
  # Stops browsers from trying to guess content types
  X-Content-Type-Options: nosniff
  
  # X-Frame-Options - Prevent clickjacking attacks
  # Prevents the site from being embedded in iframes on other domains
  X-Frame-Options: SAMEORIGIN
  
  # Referrer-Policy - Control referrer information
  # Only send full URL to same origin, origin only to cross-origin
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions-Policy - Control browser features
  # Disable geolocation, microphone, and camera access
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  
  # X-XSS-Protection - Enable XSS filter (legacy browsers)
  # Modern browsers use CSP instead, but this helps older browsers
  X-XSS-Protection: 1; mode=block
  
  # Content-Security-Policy - Control resource loading
  # Updated with SHA-256 hashes for inline scripts - removes 'unsafe-inline' for better security
  # Hashes cover Google Analytics and JSON-LD structured data scripts
  # Note: If inline scripts are modified, regenerate hashes using generate-csp-hashes.js
