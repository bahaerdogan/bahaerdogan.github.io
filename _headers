# Security Headers for Cloudflare Pages
# This file configures HTTP security headers for all pages

/*
  # HSTS - Force HTTPS for 1 year with subdomain inclusion
  # Tells browsers to always use HTTPS for this domain
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # X-Content-Type-Options - Prevent MIME type sniffing
  # Stops browsers from trying to guess content types
  X-Content-Type-Options: nosniff
  
  # X-Frame-Options - Prevent clickjacking attacks
  # Prevents the site from being embedded in iframes on other domains
  X-Frame-Options: SAMEORIGIN
  
  # Referrer-Policy - Control referrer information
  # Only send full URL to same origin, origin only to cross-origin
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions-Policy - Control browser features
  # Disable geolocation, microphone, and camera access
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  
  # X-XSS-Protection - Enable XSS filter (legacy browsers)
  # Modern browsers use CSP instead, but this helps older browsers
  X-XSS-Protection: 1; mode=block
  
  # Content-Security-Policy - Control resource loading
  # Updated with SHA-256 hashes for inline scripts - removes 'unsafe-inline' for better security
  # Hashes cover Google Analytics and JSON-LD structured data scripts
  # Note: If inline scripts are modified, regenerate hashes using generate-csp-hashes.js
  # style-src still uses 'unsafe-inline' for inline styles (can be improved in future)
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net 'sha256-3rO1aMRT/s1aa0hVkrxq0r5OPy09fxmKKvwiPdMZQig=' 'sha256-44ugiAqk5TwJq2L7hZiqzNQW0TSmHt3wk5pQq1dV2VA=' 'sha256-Iho8fY3CadBVINlDKAC2dp4MiZZCkVGP0jVdInvI85g=' 'sha256-QgS0/2+sZlauXpNfSAvlIAd6LKLpRaHs7NYhHuwkKOI=' 'sha256-TvSXTPPuC+BwKBioAC21RKx8mFAvq4ktal9re7YXQtc=' 'sha256-Xg4NizLtZ4aSiQYGEjXY8K9M/rqPGYCCsI9XROxzXVI=' 'sha256-Xidj+GQKYguYoOYikZcUEcgu9bkr1IYkqc/YLpFRQS4=' 'sha256-XxSM70Btbi4EYygW59tVjWfDCFT/KXOSDv1MixkdzvE=' 'sha256-amEb32syoDMDuIbm8lauk5Rm3UlxJDETOkP5wzEx+qQ=' 'sha256-c6zMVE+MvvGyqRa5HiouNy++g3/oWFBkUQFsHqXA7jc=' 'sha256-jmptJ5EuT6nBFlxw965CxPvSbhtI5/I0NMQuKQ7lAZE=' 'sha256-knGZa80EFhboDw+6xfhUAreCr2oqsS4KJaeqNoHv9Ok=' 'sha256-qyC/ket94Y7KB0+Xd0fEwNT2v7g8acHK4dHyZem0XV4=' 'sha256-sHxHDjSuVOB7LzxiMFt00Aj8siaNaC5czjL+LFaXfmA=' 'sha256-t+sQhmixHWOW7yxE7k4+91cgE/vETiDGdaFy1CIpAeQ=' 'sha256-uVNZPVNEX414DN1j6U+OfcrvFC95kqO/m0RDDosvBKg=' 'sha256-xyBEI4taDdmVZG4MqHH3kHpT53R1j6GWww5xe9RMXQE='; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://comment-handler.baha-erdogann.workers.dev; frame-ancestors 'self'; base-uri 'self'; form-action 'self';
  
  # Cache-Control - Control caching behavior
  # HTML files: cache for 1 day
  Cache-Control: public, max-age=86400

# Static assets - longer cache times
/*.css
  Cache-Control: public, max-age=2592000, immutable

/*.js
  Cache-Control: public, max-age=2592000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

# Security.txt - shorter cache
/.well-known/security.txt
  Cache-Control: public, max-age=86400

# Sitemap and robots - moderate cache
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# RSS feed - moderate cache
/feed.xml
  Cache-Control: public, max-age=3600
